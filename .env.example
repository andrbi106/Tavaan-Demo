# تَوان | Tavaan — Environment (Demo v0.0.1)

# Application
TVN_APP_ENV=development
TVN_APP_DEBUG=true
TVN_APP_KEY=
TVN_APP_URL=http://localhost:8000

# Autoload Cache
TVN_AUTOLOAD_CACHE=false

# Database (if needed)
TVN_DB_CONNECTION=sqlite
TVN_DB_HOST=
TVN_DB_PORT=
TVN_DB_NAME=tavaan_demo.sqlite
TVN_DB_USER=
TVN_DB_PASS=

# Cache
TVN_CACHE_DRIVER=array

# Log
TVN_LOG_LEVEL=debug
TVN_LOG_PATH=storage/logs
