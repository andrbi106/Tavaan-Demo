            "pdo"
        ]
    },
    "config": {
        "file": "config/database.php",
        "key": "database"
    },
    "tables": [],
    "commands": [],
    "facade": {
        "name": "DB",
        "accessor": "db"
    },
    "docs": "docs/03-engines/database.md",
    "class": "Tavaan\\Engine\\Database\\DatabaseEngine"
}
