{
    "id": "tavaan.engine.database",
    "type": "engine",
    "name": "Database",
    "title_fa": "دیتابیس",
    "version": "0.0.1",
    "namespace": "Tavaan\\Engine\\Database\\",
    "autoload": {
        "namespace-map": {
            "Tavaan\\Engine\\Database\\": "src/"
        }
    },
    "providers": [
        "Tavaan\\Engine\\Database\\DatabaseServiceProvider"
    ],
    "requires": {
        "php": ">=8.2",
        "engines": [
            "config",
            "event",
            "log"
        ],
