{
    "id": "tavaan.engine.session",
    "type": "engine",
    "name": "Session",
    "title_fa": "نشست",
    "version": "0.0.1",
    "namespace": "Tavaan\\Engine\\Session\\",
    "autoload": {
        "namespace-map": {
            "Tavaan\\Engine\\Session\\": "src/"
        }
    },
    "providers": [
        "Tavaan\\Engine\\Http\\Session\\SessionServiceProvider"
    ],
    "requires": {
        "php": ">=8.2",
        "engines": [
            "http",
            "crypt",
            "config"
        ]
    },
    "config": {
        "file": "config/session.php",
        "key": "session"
    },
    "tables": [
        "sessions"
    ],
    "commands": [
        "session:clear"
    ],
    "facade": {
        "name": "Session",
        "accessor": "session"
    },
    "docs": "docs/03-engines/session.md",
    "notes": "همهٔ درایورها فعال: file/cookie/array/database (M3) + redis (M4 — روی موتور cache با fallback به file).",
    "soft_requires": {
        "engines": [
            "database",
            "cache"
        ]
    },
    "class": "Tavaan\\Engine\\Session\\SessionEngine"
}
