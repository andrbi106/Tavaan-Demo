#!/usr/bin/env php
<?php

/**
 * تَوان | Tavaan — CLI (Demo v0.0.1)
 *
 * دستورات:
 *   php bin/tvn serve          سرور توسعه
 *   php bin/tvn engines        لیست موتورها + پیکربندی
 *   php bin/tvn info           اطلاعات سیستم
 *   php bin/tvn version        نسخهٔ فریمورک
 *   php bin/tvn config         پیکربندی موتورها
 */

declare(strict_types=1);

require dirname(__DIR__) . '/bootstrap.php';

use Tavaan\Core\Application\ApplicationBuilder;

$app = ApplicationBuilder::create(TVN_BASE_PATH)
    ->forConsole()
    ->boot();

$command = $argv[1] ?? 'info';

// ─── کشف موتورها ──────────────────────────────────────────────────────────
$enginesPath = TVN_BASE_PATH . '/engines';
$discoveredEngines = [];
$engineConfigs = $GLOBALS['tvn_engine_configs'] ?? [];

if (is_dir($enginesPath)) {
    foreach (new \DirectoryIterator($enginesPath) as $entry) {
        if ($entry->isDot() || !$entry->isDir()) continue;
        $ej = $entry->getPathname() . '/engine.json';
        if (is_file($ej)) {
            $data = json_decode(file_get_contents($ej), true);
            if (is_array($data)) {
                $eid = $entry->getFilename();
                $discoveredEngines[] = [
                    'id'        => $eid,
                    'name'      => $data['name'] ?? $eid,
                    'title'     => $data['title_fa'] ?? '',
                    'version'   => $data['version'] ?? '0.0.0',
                    'namespace' => $data['namespace'] ?? '',
                    'class'     => $data['class'] ?? '',
                    'has_config' => isset($engineConfigs[$eid]),
                    'config_file' => isset($engineConfigs[$eid]) ? "engines/{$eid}/config/" : '',
                ];
            }
        }
    }
    sort($discoveredEngines);
}

// ─── دستورات ──────────────────────────────────────────────────────────────

switch ($command) {
    case 'serve':
        $host = '127.0.0.1';
        $port = 8000;
        // Parse --host and --port
        for ($i = 2; $i < $argc; $i++) {
            if ($argv[$i] === '--host' && isset($argv[$i+1])) { $host = $argv[++$i]; }
            if ($argv[$i] === '--port' && isset($argv[$i+1])) { $port = (int)$argv[++$i]; }
        }
        echo "\n";
        echo "  ╔══════════════════════════════════════╗\n";
        echo "  ║  تَوان | Tavaan v" . TVN_VERSION . str_repeat(' ', 24 - strlen(TVN_VERSION)) . "║\n";
        echo "  ║  سرور توسعه                          ║\n";
        echo "  ╚══════════════════════════════════════╝\n";
        echo "\n";
        echo "  آدرس:    http://{$host}:{$port}\n";
        echo "  مسیر:    " . TVN_BASE_PATH . "/public\n";
        echo "  PHP:     " . PHP_VERSION . "\n";
        echo "  موتورها: " . count($discoveredEngines) . "\n";
        echo "\n";
        echo "  برای توقف: Ctrl+C\n";
        echo "\n";
        passthru("php -S {$host}:{$port} -t " . escapeshellarg(TVN_BASE_PATH . '/public'));
        break;

    case 'engines':
        echo "\n";
        echo "  تَوان | Tavaan v" . TVN_VERSION . " — لیست موتورها\n";
        echo "  " . str_repeat('─', 60) . "\n\n";
        printf("  %-20s %-10s %-20s %s\n", 'شناسه', 'نسخه', 'عنوان', 'پیکربندی');
        echo "  " . str_repeat('─', 60) . "\n";
        foreach ($discoveredEngines as $e) {
            $cfg = $e['has_config'] ? '⚙ بله' : '—';
            printf("  %-20s v%-9s %-20s %s\n", $e['id'], $e['version'], $e['title'], $cfg);
        }
        echo "\n  مجموع: " . count($discoveredEngines) . " موتور";
        echo " | پیکربندی: " . count($engineConfigs) . " موتور\n\n";
        break;

    case 'config':
        echo "\n";
        echo "  تَوان | Tavaan v" . TVN_VERSION . " — پیکربندی موتورها\n";
        echo "  " . str_repeat('─', 60) . "\n\n";
        if (empty($engineConfigs)) {
            echo "  هیچ پیکربندی موتوری کشف نشد.\n";
            echo "  موتورها باید فایل config/<id>.php در ساختار خود داشته باشند.\n\n";
        } else {
            foreach ($engineConfigs as $eid => $cfg) {
                $keys = is_array($cfg) ? implode(', ', array_keys($cfg)) : '(unknown)';
                printf("  %-20s کلیدها: %s\n", $eid, $keys);
            }
            echo "\n  پیکربندی یکپارچه در: config/engine.php\n\n";
        }
        break;

    case 'info':
        echo "\n";
        echo "  ╔══════════════════════════════════════╗\n";
        echo "  ║  تَوان | Tavaan — اطلاعات سیستم      ║\n";
        echo "  ╚══════════════════════════════════════╝\n";
        echo "\n";
        echo "  نسخهٔ فریمورک:  " . TVN_VERSION . "\n";
        echo "  نسخهٔ PHP:      " . PHP_VERSION . "\n";
        echo "  مسیر ریشه:     " . TVN_BASE_PATH . "\n";
        echo "  زمان اجرا:     " . date('Y-m-d H:i:s') . "\n";
        echo "  SAPI:          " . PHP_SAPI . "\n";
        echo "\n";

        $coreFiles = count(glob(TVN_BASE_PATH . '/core/*.php') ?: []) + count(glob(TVN_BASE_PATH . '/core/**/*.php') ?: []);
        $engineCoreFiles = count(glob(TVN_BASE_PATH . '/engine-core/*.php') ?: []) + count(glob(TVN_BASE_PATH . '/engine-core/**/*.php') ?: []);
        echo "  هستهٔ فریمورک:  " . $coreFiles . " فایل (core/)\n";
        echo "  موتور والد:    " . $engineCoreFiles . " فایل (engine-core/)\n";
        echo "  موتورهای فرزند: " . count($discoveredEngines) . " موتور (engines/)\n";
        echo "  پیکربندی‌ها:    " . count($engineConfigs) . " موتور دارای config\n";
        echo "\n";
        break;

    case 'version':
        echo "Tavaan v" . TVN_VERSION . "\n";
        break;

    default:
        echo "\n";
        echo "  تَوان | Tavaan v" . TVN_VERSION . " — CLI\n";
        echo "  " . str_repeat('─', 40) . "\n\n";
        echo "  دستورات:\n";
        echo "    serve      سرور توسعه (php -S 127.0.0.1:8000)\n";
        echo "    engines    لیست موتورهای کشف‌شده\n";
        echo "    config     پیکربندی موتورها\n";
        echo "    info       اطلاعات سیستم\n";
        echo "    version    نسخهٔ فریمورک\n";
        echo "\n";
        break;
}
